<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.deonmenezes.churn-tunnel</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/deonmenezes/.openswarm/tunnel/churn-tunnel.sh</string>
    </array>

    <!-- Owns both the churn backend and its tunnel, so a death in either half
         brings the whole pair back and republishes the new hostname. -->
    <key>KeepAlive</key>
    <true/>

    <key>RunAtLoad</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/deonmenezes/.openswarm/tunnel/churn/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/deonmenezes/.openswarm/tunnel/churn/launchd.err.log</string>
</dict>
</plist>
