# Copy to a local .env — never commit the filled file.
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=390346501728

# API plane (arm64). Do not point the Electron runner here.
API_INSTANCE_ID=i-0a2fa6d6bfd0bca9d
API_PUBLIC_HOST=https://54-166-194-87.sslip.io

# Windows worker.
WINDOWS_INSTANCE_ID=i-0f44590a087ac14e9
WINDOWS_WORKER_NAME=win2025-vm

# Where the runner reports. No default, so a staging dispatcher cannot
# accidentally close prod runs.
RUN_CALLBACK_BASE_URL=

# Personal Cursor API key for My Machines on win2025-vm.
# Team Admin keys cannot start personal workers.
CURSOR_API_KEY=

# Optional: only if we later add a dedicated amd64 Linux runner host.
RUNNER_INSTANCE_ID=
RUNNER_IMAGE=registry.fly.io/openswarm-runner:latest
