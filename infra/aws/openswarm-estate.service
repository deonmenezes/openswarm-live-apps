[Unit]
Description=OpenSwarm estate backend
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/opt/openswarm/estate
Environment=BACKEND_PORT=8001
ExecStart=/opt/openswarm/.venv/bin/python -m uvicorn backend.main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
